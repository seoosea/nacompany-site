{%- set pageTitle = (title + " | " + site.name) if title else (site.name + " | 대전·울산 AI·로봇 교육, 교사 연수, 기관 교육") -%}
{%- set pageDesc = summary or description or site.description -%}
{%- set pageImage = ogImage or "/assets/img/og.jpg" -%}
{%- set latestIssue = collections.issues[0].issue if collections.issues and collections.issues.length else "" -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="keywords" content="{{ site.keywords }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if issue else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ pageImage }}">
<meta name="twitter:card" content="summary_large_image">
{%- if site.naver_verification %}<meta name="naver-site-verification" content="{{ site.naver_verification }}">{% endif %}
{%- if site.google_verification %}<meta name="google-site-verification" content="{{ site.google_verification }}">{% endif %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Lexend:wght@400;700;800&family=Instrument+Serif:ital@0;1&family=Anton&family=Noto+Serif+KR:wght@400;700&family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;700&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">본문으로 바로가기</a>
<span class="side" aria-hidden="true">PLAYSTEAM<i>●</i>{{ latestIssue or "MAGAZINE" }}</span>
<header class="top"><div class="wrap">
  <a class="logo" href="/"><b>NA COMPANY<i></i></b></a>
  <nav aria-label="주요 메뉴">
    <a href="/about/" {% if page.url and page.url.startsWith('/about') %}aria-current="page"{% endif %}>회사 소개</a>
    <a href="/programs/" {% if page.url == '/programs/' %}aria-current="page"{% endif %}>맡길 수 있는 교육</a>
    <a href="/playsteam/" {% if page.url and page.url.startsWith('/playsteam') %}aria-current="page"{% endif %}>지난 호</a>
    {% if site.academy_url %}<a href="{{ site.academy_url }}" target="_blank" rel="noopener">학원 ↗</a>{% endif %}
    {% if site.lms_url %}<a href="{{ site.lms_url }}" target="_blank" rel="noopener">LMS ↗</a>{% endif %}
  </nav>
  <a class="ask" href="/programs/#contact">교육 문의</a>
</div></header>

<main id="main">
{{ content | safe }}
</main>

<footer class="foot"><div class="wrap">
  <span>{{ site.name }} · 대전 본사 · 울산 교육센터{% if site.business.ceo %} · 대표 {{ site.business.ceo }}{% endif %}{% if site.business.reg_no %} · 사업자등록번호 {{ site.business.reg_no }}{% endif %}</span>
  <span class="mono">© {{ build.year }} Na Company, Ltd.</span>
</div></footer>
<script src="/assets/js/main.js"></script>
</body>
</html>
